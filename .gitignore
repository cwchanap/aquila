# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

.vercel/
db/

test-results/
playwright-report/

apps/web/src/pages/zh/
apps/web/src/pages/ja/
.turbo/
apps/*/.turbo/
packages/*/.turbo/

coverage/

.claude/settings.local.json

# git worktrees
.worktrees/
.vercel

# Wrangler local simulation state
.wrangler/
.superpowers/

# local scratch / migration report output (e.g. .tmp/hpa-231-*.json)
.tmp/

# interrupted audio-generation CLI test fixtures created under packages/stories/raw/
packages/stories/raw/audio-generation-cli-*/

# asset generation job output (jobs.json, validation.json, gallery.html)
packages/assets/generation/

# generated story media (backgrounds, portraits) — not committed; already-tracked
# files (e.g. the_seventh_mirror) remain tracked. Each story's covers/cover.png is
# the exception: it is the committed source that media:sync publishes to R2.
packages/assets/media/*
!packages/assets/media/*/
packages/assets/media/*/*
!packages/assets/media/*/covers/
packages/assets/media/*/covers/*
!packages/assets/media/*/covers/cover.png

# asset publisher local-store sidecars and transaction markers
.publisher-metadata/
.publisher-transactions/
