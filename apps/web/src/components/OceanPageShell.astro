---
import MainLayout from '../layouts/main.astro';
import OceanBackground from './OceanBackground.astro';
import UserStatus from './UserStatus.svelte';
import AuthDegradedBanner from './AuthDegradedBanner.astro';
import type { Locale } from '@aquila/stories';
import type { User } from '../lib/auth.js';
import { t as translate } from '../lib/utils';

interface Props {
  locale: Locale;
  title: string;
  heading: string;
  tagline: string;
  user: User | null;
  authFailed: boolean;
}

const { locale, title, heading, tagline, user, authFailed } = Astro.props;
const t = (key: string) => translate(locale, key);
---

<MainLayout title={title}>
  {authFailed && <AuthDegradedBanner message={t('auth.degradedBanner')} />}
  <OceanBackground>

    <!-- Back button — refined glass pill -->
    <a
      href={`/${locale}/`}
      aria-label={t("common.backLabel")}
      class="absolute top-6 left-6 z-20 flex items-center gap-2 px-4 py-2.5 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 hover:border-white/40 text-slate-800 hover:text-slate-950 transition-all duration-300 motion-safe:hover:scale-105 text-sm font-light tracking-wide"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      <span>{t("common.back")}</span>
    </a>

    <!-- User status -->
    <UserStatus client:load user={user} currentLocale={locale} />

    <!-- Main content -->
    <div class="min-h-screen flex flex-col items-center px-4 sm:px-6 py-24">

      <!-- Header -->
      <div class="text-center mb-12 motion-safe:animate-[fadeSlideDown_0.7s_ease_forwards]">
        <!-- Ambient divider above -->
        <div class="flex items-center justify-center gap-3 mb-6">
          <div class="h-px w-16 bg-linear-to-r from-transparent to-cyan-300/50"></div>
          <!-- Subtle accent: slow-drifting tide mark -->
          <div class="w-2 h-2 rounded-full bg-cyan-300/60 motion-safe:animate-[tidePulse_4s_ease-in-out_infinite]"></div>
          <div class="h-px w-16 bg-linear-to-l from-transparent to-cyan-300/50"></div>
        </div>

        <h1 class="text-4xl sm:text-5xl font-serif font-bold text-white/95 tracking-tight drop-shadow-lg mb-3">
          {heading}
        </h1>
        <p class="text-slate-800 text-sm tracking-[0.25em] uppercase font-light">
          {tagline}
        </p>
      </div>

      <slot />

    </div>

  </OceanBackground>
</MainLayout>
