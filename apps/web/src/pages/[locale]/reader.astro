---
import MainLayout from '@/layouts/main.astro';
import AuthDegradedBanner from '@/components/AuthDegradedBanner.astro';
import { getTranslations, isLocale } from '@aquila/stories/translations';
import type { Locale } from '@aquila/stories';
import { authStateFromSession, getSessionUser, SESSION_LOOKUP_TIMEOUT_MS } from '@/lib/auth-utils';
import { t as translate } from '@/lib/utils';

interface Props {
  locale?: string;
}

const rawLocale = (Astro.props.locale as string | undefined) || Astro.params.locale;
const locale: Locale = isLocale(rawLocale) ? rawLocale : 'en';
const translations = getTranslations(locale);
const title = translations.reader.title;
const sessionResult = await getSessionUser(Astro.request, { timeoutMs: SESSION_LOOKUP_TIMEOUT_MS });
const authState = authStateFromSession(sessionResult);
const authFailed = sessionResult.status === 'error';
const userId = sessionResult.status === 'ok' ? (sessionResult.user?.id ?? null) : null;
---

<MainLayout title={title}>
    {authFailed && <AuthDegradedBanner message={translate(locale, 'auth.degradedBanner')} />}
    <div id="reader-container" class="min-h-screen" data-locale={translations.locale} data-auth-state={authState} data-user-id={userId}>
        <!-- Reader will be mounted here -->
    </div>

    <script>
        import { startReader } from '@/lib/reader-bootstrap';

        document.addEventListener('DOMContentLoaded', () => startReader());
    </script>
</MainLayout>
