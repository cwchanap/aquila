---
import OceanPageShell from '../../../components/OceanPageShell.astro';
import StorySelect from '../../../components/StorySelect.svelte';
import type { Locale } from '@aquila/stories';
import { isLocale } from '@aquila/stories/translations';
import { authStateFromSession, getSessionUser, SESSION_LOOKUP_TIMEOUT_MS } from '../../../lib/auth-utils.js';
import { t as translate } from '../../../lib/utils';

interface Props {
  locale?: string;
}

const rawLocale = (Astro.props.locale as string | undefined) || Astro.params.locale || 'en';
const locale: Locale = isLocale(rawLocale) ? rawLocale : 'en';
const t = (key: string) => translate(locale, key);

const sessionResult = await getSessionUser(Astro.request, { timeoutMs: SESSION_LOOKUP_TIMEOUT_MS });
const user = sessionResult.status === 'ok' ? sessionResult.user : null;
const authFailed = sessionResult.status === 'error';
const authState = authStateFromSession(sessionResult);
---

<OceanPageShell
  locale={locale}
  title={t("stories.title")}
  heading={t("stories.heading")}
  tagline={t("stories.chooseYourAdventure")}
  user={user}
  authFailed={authFailed}
>
  <StorySelect client:load locale={locale} authState={authState} userId={user?.id ?? null} />
</OceanPageShell>
