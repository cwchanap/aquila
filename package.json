{
  "name": "aquila",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=!desktop",
    "dev:web": "turbo run dev --filter=web",
    "build": "turbo run build",
    "compile:stories": "bun --filter @aquila/stories compile",
    "compile:check": "bun run compile:stories && git diff --exit-code -- packages/stories/src/generated packages/stories/src/stories",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=e2e",
    "test:ui": "turbo run test:ui --filter=e2e",
    "test:headed": "turbo run test:headed --filter=e2e",
    "test:debug": "turbo run test:debug --filter=e2e",
    "test:report": "turbo run test:report --filter=e2e",
    "prepare": "husky",
    "drizzle:generate": "turbo run drizzle:generate --filter=web",
    "drizzle:migrate": "turbo run drizzle:migrate --filter=web",
    "drizzle:studio": "turbo run drizzle:studio --filter=web"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.34.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-svelte": "^3.23.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "svelte-eslint-parser": "^1.9.0",
    "turbo": "^2.11.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{astro,svelte}": [
      "eslint --fix"
    ]
  }
}
