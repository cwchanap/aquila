  "lineDirections": {
    "act3": {
      "13": {
        "zh": "一⋯⋯一定是某種宣傳活動⋯⋯對，是利用大氣反射原理製造的海市蜃樓⋯⋯全息投影⋯⋯",
        "direction": "[nervous] [stammering]"
      }
    },
    "b1a_act5": {
      "38": {
        "zh": "(猛然轉頭，內心)這是...車門的聲音！",
        "direction": "[startled] [alarmed]"
      },
      "40": {
        "zh": "(驚叫)門...門關了！",
        "direction": "[shouting] [alarmed]"
      }
    },
    "b1a_act6": {
      "4": {
        "zh": "(情緒崩潰，帶著哭腔指著李杰)都是你！如果你不帶頭下車，我們現在就已經在回家的路上了！",
        "direction": "[crying] [angry]"
      },
      "41": {
        "zh": "(突然大喊)等...等等我！你們別丟下我一個人！",
        "direction": "[shouting] [panicked]"
      }
    },
    "b1a_b2a_b3a_act12": {
      "11": {
        "zh": "(看到血跡,臉色更加蒼白) 血...是血...眼鏡男...是不是被...被野獸襲擊了?森林裡...會不會有...很可怕的動物?",
        "direction": "[frightened] [trembling voice]"
      }
    },
    "b1a_b2a_b3a_act13": {
      "8": {
        "zh": "(也跟著喊,聲音有些顫抖) 有人在嗎——?",
        "direction": "[shouting] [trembling voice]"
      }
    },
    "b1b_act6": {
      "32": {
        "zh": "(第一個崩潰,聲音因恐懼而顫抖)幽⋯⋯幽冥⋯⋯之都?這是什麼鬼地方?",
        "direction": "[terrified] [trembling voice]"
      },
      "33": {
        "zh": "(哭腔)這不是回家的路⋯⋯我們回不去了⋯⋯嗚嗚嗚⋯⋯",
        "direction": "[sobbing]"
      },
      "35": {
        "zh": "(臉色慘白,驚慌失措地大叫)完了!我們完了!這是地獄的入口嗎?我們會被鬼抓走的!我不想死啊!",
        "direction": "[screaming] [panicked]"
      },
      "38": {
        "zh": "(也哭了起來)我們⋯⋯我們真的回不去了嗎?",
        "direction": "[crying]"
      }
    },
    "b1b_act7": {
      "5": {
        "zh": "(憤怒地大吼)都是你這種膽小鬼!剛才在「寂海」站屁都不敢放一個!現在就知道鬼吼鬼叫!",
        "direction": "[shouting] [furious]"
      },
      "8": {
        "zh": "(將家人護在身後,憤怒地回擊)你吼什麼!孩子害怕哭一下怎麼了?你有時間在這裡亂罵人,不如想想怎麼離開這裡!",
        "direction": "[shouting] [angry]"
      },
      "65": {
        "zh": "(哭著說)他們吵得很兇,然後就開始推來推去⋯⋯媽媽也在哭⋯⋯",
        "direction": "[crying]"
      }
    },
    "b1b_act8": {
      "10": {
        "zh": "(聲音嘶啞,絕望地喊)等等⋯⋯等等啊⋯⋯",
        "direction": "[desperate] [crying out]"
      },
      "12": {
        "zh": "(哭著撲向母親)媽媽!",
        "direction": "[crying]"
      },
      "18": {
        "zh": "(泣不成聲)你爸爸⋯⋯你爸爸他⋯⋯",
        "direction": "[sobbing]"
      },
      "34": {
        "zh": "(哭泣)就像之前一樣,門突然就關了⋯⋯我的丈夫還在車上⋯⋯",
        "direction": "[crying]"
      }
    },
    "b1b_b2a_act11": {
      "22": {
        "zh": "(緩緩放下手,低聲)死了⋯⋯",
        "direction": "[shaken] [horrified]"
      },
      "48": {
        "zh": "(跪下,翻過身體)小林先生!",
        "direction": "[shouting] [desperate]"
      },
      "54": {
        "zh": "(顫抖著伸手觸碰傷口邊緣)這是⋯⋯劍傷?",
        "direction": "[trembling voice] [horrified]"
      },
      "58": {
        "zh": "(內心,震驚)這是⋯⋯被謀殺的。而且兇手用的是劍⋯⋯",
        "direction": "[shocked] [shaken]"
      },
      "68": {
        "zh": "(內心)如果連小林先生這樣一個成年男性都能被輕易殺害⋯⋯那留在小屋裡的小林智子和孩子們⋯⋯",
        "direction": "[alarmed] [fearful]"
      },
      "70": {
        "zh": "(猛然站起,驚恐)他們有危險!",
        "direction": "[panicked] [shouting]"
      }
    },
    "b1b_b2a_act12": {
      "10": {
        "zh": "(大喊)小林女士!",
        "direction": "[shouting] [desperate]"
      }
    },
    "b1b_b2a_act13": {
      "45": {
        "zh": "(心中一緊)小林女士!",
        "direction": "[shouting] [desperate]"
      },
      "59": {
        "zh": "(緩緩收回手)死了⋯⋯",
        "direction": "[shaken] [horrified]"
      }
    },
    "b1b_b2a_act14": {
      "22": {
        "zh": "(內心,震驚)這個尺寸⋯⋯和我追蹤過來的那行女性腳印一樣!",
        "direction": "[shocked] [alarmed]"
      },
      "36": {
        "zh": "(低聲)至少⋯⋯讓你安息吧。",
        "direction": "[choked up] [sorrowful]"
      },
      "40": {
        "zh": "(對著墳墓)對不起⋯⋯",
        "direction": "[voice breaking] [anguished]"
      }
    },
    "b1a_b2a_act8": {
      "10": {
        "zh": "(朝著前方的濃霧大喊)大叔！你們在哪裡？",
        "direction": "[shouting]"
      },
      "11": {
        "zh": "(也鼓起勇氣，用顫抖的聲音喊道)有人在嗎——？",
        "direction": "[shouting] [trembling voice]"
      }
    },
    "b1b_act4": {
      "26": {
        "zh": "(喃喃自語)等等!",
        "direction": "[shouting] [urgent]"
      },
      "33": {
        "zh": "(用力拍打車門)該死⋯⋯",
        "direction": "[angry] [shouting]"
      }
    },
    "b1b_b2a_b3a_act15": {
      "12": {
        "zh": "(喘著氣)先補充一些補給...",
        "direction": "[breathless]"
      },
      "16": {
        "zh": "(愣住)這是...",
        "direction": "[sharp gasp] [alarmed]"
      },
      "22": {
        "zh": "(低聲)該死...我太大意了。",
        "direction": "[angry] [frustrated]"
      },
      "31": {
        "zh": "(低聲,震驚)有東西...從後門闖進來了。",
        "direction": "[shocked] [alarmed]"
      },
      "38": {
        "zh": "(內心,自責)衣櫃...我之前兩次進出,竟然都完全忽略了它。",
        "direction": "[regretful] [shaken]"
      },
      "48": {
        "zh": "(屏住呼吸)",
        "direction": "[sharp gasp] [horrified]",
        "text": "ひっ……！"
      }
    },
    "b1b_b2a_b3a_act16": {
      "3": {
        "zh": "(深呼吸,閉上眼睛)冷靜...必須冷靜...",
        "direction": "[shaky breath] [trembling voice]"
      },
      "6": {
        "zh": "(低聲)對不起...我來晚了。",
        "direction": "[voice breaking] [anguished]"
      },
      "10": {
        "zh": "(皺眉)沒有刺傷...沒有割傷...",
        "direction": "[stunned] [trembling voice]"
      },
      "13": {
        "zh": "(低聲)窒息...被掐死的。",
        "direction": "[horrified] [shaking]"
      },
      "15": {
        "zh": "(內心)要在短時間內掐死一個成年女性...需要壓倒性的力量。而且必須動作迅速,不給對方任何逃脫或呼救的機會。",
        "direction": "[tense] [shaken]"
      },
      "17": {
        "zh": "(內心)那個眼鏡男...他看起來很瘦弱,而且膽小。應該沒有這種力量。",
        "direction": "[tense] [shaken]"
      },
      "19": {
        "zh": "(內心)那兩個男大學生...其中一個看起來比較瘦弱,不像是能輕易制伏成年女性的體格。",
        "direction": "[tense] [shaken]"
      },
      "21": {
        "zh": "(內心)但那個沉穩的大叔...他體格健壯,而且看起來很有力量。還有那個看起來像運動社團的男大學生,他也有足夠的體力。",
        "direction": "[tense] [uneasy]"
      },
      "23": {
        "zh": "(內心)但這些都只是猜測。更重要的是...還有那些我們完全不了解的「第三方」。殺死小林先生的那個用劍的人,很可能就在附近。",
        "direction": "[urgent] [alarmed]"
      },
      "25": {
        "zh": "(站起身,深吸一口氣)至少...讓她安息吧。",
        "direction": "[choked up] [sorrowful]"
      },
      "31": {
        "zh": "(低聲)你的孩子們...我一定會找到他們。我向你保證。",
        "direction": "[choked up] [fierce]"
      },
      "36": {
        "zh": "(喘息)必須...休息一下...",
        "direction": "[panting] [exhausted]"
      },
      "39": {
        "zh": "(皺眉)那是什麼?",
        "direction": "[alarmed] [tense]"
      },
      "42": {
        "zh": "(撿起手機)這個...我好像在哪裡見過。",
        "direction": "[uneasy] [shaken]"
      },
      "44": {
        "zh": "(放下手機,拿起冊子)這是...日記?還是素描本?",
        "direction": "[uneasy] [tense]"
      }
    },
    "b1b_b2a_b3a_actFinal": {
      "14": {
        "zh": "(皺眉,內心)精靈?契約?這是什麼...某個瘋子的妄想日記嗎?",
        "direction": "[softly] [disbelieving]"
      },
      "16": {
        "zh": "(內心)還是說...這是一場精心設計的真人實境遊戲?某種變態的劇本殺?",
        "direction": "[softly] [disbelieving]"
      },
      "22": {
        "zh": "(瞳孔收縮)這是...",
        "direction": "[sharp gasp] [stunned]"
      },
      "25": {
        "zh": "(顫抖著,低聲)我的名字...為什麼我排在第一個?",
        "direction": "[shaken] [trembling voice]"
      },
      "27": {
        "zh": "(內心,震驚)寫下這個計畫的人...從一開始就知道我們會登上那輛列車?",
        "direction": "[stunned] [shaken]"
      },
      "32": {
        "zh": "(驚恐,內心)我的名字...被劃掉了?這是說...我也會死?",
        "direction": "[terrified] [voice breaking]"
      },
      "42": {
        "zh": "(喘息)這到底...",
        "direction": "[panting] [overwhelmed]"
      },
      "57": {
        "zh": "(眼睛睜大,無法出聲)",
        "direction": "[agonized] [sharp gasp]",
        "text": "ぐあっ……！"
      },
      "62": {
        "zh": "(想要說話,但只能發出微弱的氣音)",
        "direction": "[choking] [dying breath]",
        "text": "……あ……っ……"
      }
    },
    "b1b_b2a_b3b_act15": {
      "2": {
        "zh": "(內心,帶著一絲愧疚)對不起...在這裡,活下去才是第一要務。",
        "direction": "[regretful] [subdued]"
      },
      "9": {
        "zh": "(走到月台邊緣)至少...讓你入土為安。",
        "direction": "[somber] [gentle]"
      },
      "18": {
        "zh": "(看著這四個字,低聲重複)終焉...祭壇...",
        "direction": "[uneasy] [murmuring]"
      },
      "21": {
        "zh": "(內心)這條小徑到這裡就結束了...要前往下一站,唯一的路,就是沿著鐵軌走下去。",
        "direction": "[resigned] [tired]"
      },
      "23": {
        "zh": "(內心)應該夠撐到下一站...但還是要省著用。",
        "direction": "[tired] [pragmatic]"
      },
      "36": {
        "zh": "(內心,沉重)他們現在是死是活?",
        "direction": "[worried] [heavy-hearted]"
      },
      "41": {
        "zh": "(內心)而小林女士和孩子們...就那樣從小屋裡消失了。他們到底去了哪裡?還活著嗎?",
        "direction": "[worried] [anxious]"
      },
      "43": {
        "zh": "(內心)那個用劍殺人的兇手...會不會就是車上的某個乘客?還是說,這裡本身就存在著我們不知道的威脅?",
        "direction": "[suspicious] [uneasy]"
      },
      "51": {
        "zh": "(停下腳步,警惕地環顧四周)這裡...",
        "direction": "[wary] [tense]"
      },
      "57": {
        "zh": "(低聲,難以置信)這就是...",
        "direction": "[stunned] [disbelieving]"
      }
    },
    "b1b_b2a_b3b_act16": {
      "3": {
        "zh": "(低聲)這裡...真的是車站嗎?",
        "direction": "[uneasy] [wary]"
      },
      "14": {
        "zh": "(看著長廊,內心)那裡...才是這座建築的核心。",
        "direction": "[wary] [certain]"
      },
      "16": {
        "zh": "(低聲)先去月台。",
        "direction": "[determined] [composed]"
      },
      "19": {
        "zh": "(停下腳步,震驚)這是...",
        "direction": "[shocked] [stunned]"
      },
      "24": {
        "zh": "(看向遠方,輕聲)好美...",
        "direction": "[awed] [gentle]"
      },
      "34": {
        "zh": "(內心)永恆之森...還不是終點。",
        "direction": "[uneasy] [thoughtful]"
      },
      "36": {
        "zh": "(內心)那個膽小的眼鏡男,還有那個焦慮的中年女人...按照規律,應該有一人下車,一人繼續前進。",
        "direction": "[thoughtful] [wary]"
      },
      "38": {
        "zh": "(環顧月台)人呢?",
        "direction": "[puzzled] [uneasy]"
      },
      "45": {
        "zh": "(停下腳步,困惑)怎麼回事?",
        "direction": "[confused] [uneasy]"
      },
      "47": {
        "zh": "(內心)規律被打破了?還是...他們兩個都留在車上了?",
        "direction": "[baffled] [tense]"
      },
      "49": {
        "zh": "(內心)難道「永恆之森」有什麼特殊之處,讓列車的規則改變了?",
        "direction": "[puzzled] [thoughtful]"
      }
    },
    "b1b_b2a_b3b_b4a_act17": {
      "3": {
        "zh": "(握緊手中的劍)繼續前進。",
        "direction": "[determined] [composed]"
      },
      "8": {
        "zh": "(內心)這裡...像是某種儀式的場所。",
        "direction": "[awed] [uneasy]"
      },
      "13": {
        "zh": "(下意識地抬手遮眼)啊...",
        "direction": "[wincing] [startled]"
      },
      "17": {
        "zh": "(慢慢放下手,感受著陽光)陽光...真的是陽光...",
        "direction": "[relieved] [moved]"
      },
      "23": {
        "zh": "(低聲)活著...真好。",
        "direction": "[relieved] [warm]"
      },
      "29": {
        "zh": "(停下腳步,環顧四周)這裡...",
        "direction": "[awed] [disbelieving]"
      },
      "34": {
        "zh": "(走近,蹲下身,伸手試探)溫泉?",
        "direction": "[curious] [surprised]"
      },
      "37": {
        "zh": "(站起身,看著溫泉)在這廣闊的森林中...這簡直是奇蹟。",
